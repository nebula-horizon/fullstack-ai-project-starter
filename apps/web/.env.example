# apps/web — LOCAL development only. Copy to apps/web/.env (git-ignored).
#
# Every VITE_* variable is compiled into the browser bundle and is PUBLIC.
# Only the Supabase URL and the anon (publishable) key belong here. The
# service-role key must never appear in this app, in any VITE_* variable, or in git.
#
# Local values are printed by `mise run db:status`. In deployed dev/prod these are
# passed as Docker build args by .github/workflows/deploy-web.yml (URL from SSM,
# anon key from Secrets Manager) — see docs/security/secrets-inventory.md.
VITE_SUPABASE_URL=http://127.0.0.1:54326
VITE_SUPABASE_ANON_KEY=<anon key from `mise run db:status`>
