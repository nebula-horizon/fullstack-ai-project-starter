# apps/web — LOCAL development only. Copy to apps/web/.env (git-ignored).
#
# These are read by the web SERVER at runtime (vite.config.ts loads this file
# into process.env locally) and handed to the browser per request. They have no
# VITE_ prefix on purpose, so Vite never compiles them into the bundle and one
# image serves every environment. In deployed dev/prod, ECS injects them when
# the task starts — see docs/security/secrets-inventory.md.
#
# Only browser-safe values belong here: the Supabase URL and the anon key.
# The service-role key must never appear in this app or in git.
SUPABASE_URL=http://127.0.0.1:54326
SUPABASE_ANON_KEY=<anon key from `mise run db:status`>
