{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./data": "./.adonisjs/client/data.d.ts",
    "./registry": "./.adonisjs/client/registry/index.ts"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node --import tsx ace build",
    "dev": "node ace serve --hmr",
    "test": "node --import tsx bin/test.js",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#services/*": "./app/services/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#commands/*": "./commands/*.js",
    "#infrastructure/*": "./app/infrastructure/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.7.1",
    "@types/node": "~25.6.0",
    "@types/pg": "^8.20.0",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/core": "^7.3.1",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/shield": "^9.0.0",
    "@japa/api-client": "^3.2.1",
    "@rnwonder/adonis-autoswagger": "^1.1.8",
    "@template/db": "workspace:*",
    "@tuyau/core": "^1.2.2",
    "@vinejs/vine": "^4.3.1",
    "jose": "^5.2.0",
    "kysely": "^0.27.3",
    "luxon": "^3.7.2",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  }
}
