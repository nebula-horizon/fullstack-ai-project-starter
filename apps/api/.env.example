# apps/api — LOCAL development only. Copy to apps/api/.env (git-ignored).
#
# Names and shapes only. The two concrete
# values below (DATABASE_URL, JWT_SECRET) are the PUBLIC defaults of the local
# Supabase CLI stack under tools/supabase — they open nothing outside your laptop.
#
# Deployed dev/prod never read this file. There, secrets come from AWS Secrets
# Manager and are injected into the ECS task by ARN — see
# docs/security/secrets-inventory.md.

# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
# Generate per machine: `node --import tsx ace.js generate:key` (inside apps/api).
# Never reuse a key between environments, and never commit one.
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Database — local Supabase CLI Postgres (see `mise run db:status`).
# Shape in dev/prod: postgresql://<user>:<password>@<host>:<port>/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

# Auth — must match the Supabase project's JWT secret so Supabase-issued access
# tokens verify here. The value below is the local Supabase CLI default.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Supabase server-side keys — OPTIONAL, only if the API calls Supabase admin APIs.
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security: it lives ONLY in the API
# (Secrets Manager in dev/prod) and never in apps/web, a VITE_* variable, or git.
# SUPABASE_URL=http://127.0.0.1:54326
# SUPABASE_SERVICE_ROLE_KEY=<from `supabase status`>

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
