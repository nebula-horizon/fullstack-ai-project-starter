# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=zKXHe-Ahdb7aPK1ylAJlRgTefktEaACi
APP_URL=http://${HOST}:${PORT}

# Database (local Supabase CLI Postgres — see `supabase status`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

# Auth — must match the Supabase JWT secret so Supabase-issued access tokens
# verify here. This default is the local Supabase CLI signing secret.
# For production, set this to your project's JWT secret (or switch the
# jwt_auth_middleware to JWKS verification for asymmetric keys).
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
