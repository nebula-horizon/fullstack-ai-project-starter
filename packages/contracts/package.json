{
  "name": "@template/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "API contracts and generated types",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run compile-contracts && tsup src/index.ts --format esm --dts",
    "compile-contracts": "openapi-typescript openapi.yaml -o src/api.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^6.7.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
