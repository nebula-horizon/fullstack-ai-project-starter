# Grouped by category, one comment per block. Personal editor/IDE files
# (.vscode/, .idea/, *.swp) are deliberately NOT listed here — put them in your
# own global gitignore (`git config --global core.excludesFile ~/.gitignore_global`).

# Dependencies — reinstalled from pnpm-lock.yaml, which IS committed (the
# Dockerfiles install with --frozen-lockfile).
node_modules/
.pnpm-store/
.npm-overrides/

# Build output
dist/
build/
.output/
.vinxi/
.tanstack/
coverage/
.nyc_output/
*.lcov
*.tsbuildinfo
.turbo/
.cache/

# Logs
*.log

# Tool state and scratch — can reveal account IDs and connection details
.terraform/
*.tfstate
*.tfstate.*
tfplan
**/.temp/
**/.tmp/
**/supabase/.branches/

# Local environment files hold real values, so they stay out of git.
# .env.example files carry names and shapes only. apps/api/.env.test is tracked
# on purpose: it holds test-runner overrides only (no credentials, no URLs).
.env
.env.*
!.env.example
!.env.test

# Credentials — should never exist in the tree; ignored as a second line of defence
*.pem
*.p12
id_rsa*

# OS noise
.DS_Store
Thumbs.db

# Claude Code. `pnpm install` (scripts/bootstrap.js --link) links .claude/skills
# and .claude/commands to .agents/, the tracked source; the links, personal
# settings and saved workflows stay out of git. Anchored with a leading slash
# because they only ever exist at the repository root.
/.claude/skills
/.claude/commands
/.claude/workflows/
.claude/settings.local.json
